@SuppressWarnings({"rawtypes", "unchecked"})
public class LLMStatsUtilTest {

    private static final String WINDOW = "600";
    private static final String STREAM = "default";

    @Test
    public void aggBoltLatAndCountAggregatesWeightedTotals() {
        List<String> stream = Arrays.asList("component", STREAM);
        Map<List<String>, Double> executeLatency = singletonMap(stream, 2.0d);
        Map<List<String>, Double> processLatency = singletonMap(stream, 3.0d);
        Map<List<String>, Long> executed = singletonMap(stream, 10L);

        Map<String, Number> result = StatsUtil.aggBoltLatAndCount(executeLatency, processLatency, executed);

        assertEquals(20.0d, result.get("executeLatencyTotal").doubleValue(), 0.0001d);
        assertEquals(30.0d, result.get("processLatencyTotal").doubleValue(), 0.0001d);
        assertEquals(10L, result.get("executed").longValue());
    }

    @Test
    public void aggBoltLatAndCountHandlesNullInput() {
        Map<String, Number> result = StatsUtil.aggBoltLatAndCount(null, null, null);

        assertEquals(0.0d, result.get("executeLatencyTotal").doubleValue(), 0.0d);
        assertEquals(0.0d, result.get("processLatencyTotal").doubleValue(), 0.0d);
        assertEquals(0L, result.get("executed").longValue());
    }

    @Test
    public void aggSpoutLatAndCountAggregatesWeightedTotal() {
        Map<String, Double> latencies = new HashMap<>();
        latencies.put(STREAM, 2.0d);
        latencies.put("metrics", 4.0d);
        Map<String, Long> acked = new HashMap<>();
        acked.put(STREAM, 5L);
        acked.put("metrics", 7L);

        Map<String, Number> result = StatsUtil.aggSpoutLatAndCount(latencies, acked);

        assertEquals(38.0d, result.get("completeLatencyTotal").doubleValue(), 0.0001d);
        assertEquals(12L, result.get("acked").longValue());
    }

    @Test
    public void aggBoltStreamsLatAndCountAggregatesOneStream() {
        Map<String, Map> result = StatsUtil.aggBoltStreamsLatAndCount(
            singletonMap(STREAM, 10.0d), singletonMap(STREAM, 3.0d), singletonMap(STREAM, 4L));

        assertEquals(40.0d, ((Number) result.get(STREAM).get("executeLatencyTotal")).doubleValue(), 0.0001d);
        assertEquals(12.0d, ((Number) result.get(STREAM).get("processLatencyTotal")).doubleValue(), 0.0001d);
        assertEquals(4L, ((Number) result.get(STREAM).get("executed")).longValue());
    }

    @Test
    public void aggBoltStreamsLatAndCountOmitsMissingProcessLatency() {
        Map<String, Map> result = StatsUtil.aggBoltStreamsLatAndCount(
            singletonMap(STREAM, 5.0d), null, singletonMap(STREAM, 3L));

        assertEquals(15.0d, ((Number) result.get(STREAM).get("executeLatencyTotal")).doubleValue(), 0.0001d);
        assertFalse(result.get(STREAM).containsKey("processLatencyTotal"));
    }

    @Test
    public void aggBoltStreamsLatAndCountReturnsMutableEmptyMapForNullInput() {
        Map<String, Map> result = StatsUtil.aggBoltStreamsLatAndCount(null, null, null);

        assertTrue(result.isEmpty());
        result.put(STREAM, new HashMap());
        assertTrue(result.containsKey(STREAM));
    }

    @Test
    public void aggSpoutStreamsLatAndCountAggregatesOneStream() {
        Map<String, Map> result = StatsUtil.aggSpoutStreamsLatAndCount(
            singletonMap(STREAM, 6.5d), singletonMap(STREAM, 8L));

        assertEquals(52.0d, ((Number) result.get(STREAM).get("completeLatencyTotal")).doubleValue(), 0.0001d);
        assertEquals(8L, ((Number) result.get(STREAM).get("acked")).longValue());
    }

    @Test
    public void aggSpoutStreamsLatAndCountReturnsMutableEmptyMapForNullInput() {
        Map<String, Map> result = StatsUtil.aggSpoutStreamsLatAndCount(null, null);

        assertTrue(result.isEmpty());
        result.put(STREAM, new HashMap());
        assertTrue(result.containsKey(STREAM));
    }

    @Test
    public void aggregateCountStreamsSumsValuesPerWindow() {
        Map<String, Long> streams = new HashMap<>();
        streams.put(STREAM, 3L);
        streams.put("metrics", 4L);
        Map<String, Map<String, Long>> input = singletonMap(WINDOW, streams);

        assertEquals(Long.valueOf(7L), StatsUtil.aggregateCountStreams(input).get(WINDOW));
    }

    @Test
    public void aggregateCountStreamsPreservesZero() {
        Map<String, Map<String, Long>> input = singletonMap(WINDOW, singletonMap(STREAM, 0L));

        assertEquals(Long.valueOf(0L), StatsUtil.aggregateCountStreams(input).get(WINDOW));
    }

    @Test
    public void aggregateCountsSumsDuplicateWindowsAndStreams() {
        Map<String, Map<String, Long>> first = singletonMap(WINDOW, singletonMap(STREAM, 3L));
        Map<String, Long> secondStreams = new HashMap<>();
        secondStreams.put(STREAM, 4L);
        secondStreams.put("metrics", 2L);
        Map<String, Map<String, Long>> second = singletonMap(WINDOW, secondStreams);

        Map<String, Map<String, Long>> result = StatsUtil.aggregateCounts(Arrays.asList(first, second));

        assertEquals(Long.valueOf(7L), result.get(WINDOW).get(STREAM));
        assertEquals(Long.valueOf(2L), result.get(WINDOW).get("metrics"));
    }

    @Test
    public void aggregateAveragesCalculatesWeightedAverage() {
        Map<String, Map<String, Double>> firstAverage = singletonMap(WINDOW, singletonMap(STREAM, 2.0d));
        Map<String, Map<String, Double>> secondAverage = singletonMap(WINDOW, singletonMap(STREAM, 4.0d));
        Map<String, Map<String, Long>> firstCount = singletonMap(WINDOW, singletonMap(STREAM, 10L));
        Map<String, Map<String, Long>> secondCount = singletonMap(WINDOW, singletonMap(STREAM, 20L));

        Map<String, Map<String, Double>> result = StatsUtil.aggregateAverages(
            Arrays.asList(firstAverage, secondAverage), Arrays.asList(firstCount, secondCount));

        assertEquals(100.0d / 30.0d, result.get(WINDOW).get(STREAM), 0.0001d);
    }

    @Test
    public void aggregateAveragesReturnsMutableEmptyMapForEmptyInput() {
        Map<String, Map<String, Double>> result = StatsUtil.aggregateAverages(new ArrayList<>(), new ArrayList<>());

        assertTrue(result.isEmpty());
        result.put(WINDOW, new HashMap<String, Double>());
        assertTrue(result.containsKey(WINDOW));
    }

    @Test
    public void aggregateAvgStreamsCalculatesWeightedAverageAcrossStreams() {
        Map<String, Double> averageStreams = new HashMap<>();
        averageStreams.put(STREAM, 2.0d);
        averageStreams.put("metrics", 5.0d);
        Map<String, Long> countStreams = new HashMap<>();
        countStreams.put(STREAM, 10L);
        countStreams.put("metrics", 30L);

        Map<String, Double> result = StatsUtil.aggregateAvgStreams(
            singletonMap(WINDOW, averageStreams), singletonMap(WINDOW, countStreams));

        assertEquals(4.25d, result.get(WINDOW), 0.0001d);
    }

    @Test
    public void aggregateAvgStreamsUsesZeroForMissingAverage() {
        Map<String, Double> averageStreams = singletonMap(STREAM, 2.0d);
        Map<String, Long> countStreams = new HashMap<>();
        countStreams.put(STREAM, 10L);
        countStreams.put("metrics", 30L);

        Map<String, Double> result = StatsUtil.aggregateAvgStreams(
            singletonMap(WINDOW, averageStreams), singletonMap(WINDOW, countStreams));

        assertEquals(0.5d, result.get(WINDOW), 0.0001d);
    }

    @Test
    public void aggregateAvgStreamsReturnsZeroForZeroCount() {
        Map<String, Double> result = StatsUtil.aggregateAvgStreams(
            singletonMap(WINDOW, singletonMap(STREAM, 5.0d)),
            singletonMap(WINDOW, singletonMap(STREAM, 0L)));

        assertEquals(0.0d, result.get(WINDOW), 0.0d);
    }

    @Test
    public void aggregateSpoutStreamsAggregatesAllMetrics() {
        Map<String, Map> stats = new HashMap<>();
        stats.put("acked", twoStreamLongWindow(5L, 7L));
        stats.put("failed", twoStreamLongWindow(1L, 2L));
        stats.put("emitted", twoStreamLongWindow(10L, 20L));
        stats.put("transferred", twoStreamLongWindow(30L, 40L));
        stats.put("complete-latencies", twoStreamDoubleWindow(2.0d, 4.0d));

        Map<String, Map> result = StatsUtil.aggregateSpoutStreams(stats);

        assertEquals(12L, ((Number) result.get("acked").get(WINDOW)).longValue());
        assertEquals(3L, ((Number) result.get("failed").get(WINDOW)).longValue());
        assertEquals(30L, ((Number) result.get("emitted").get(WINDOW)).longValue());
        assertEquals(70L, ((Number) result.get("transferred").get(WINDOW)).longValue());
        assertEquals(19.0d / 6.0d, ((Number) result.get("complete-latencies").get(WINDOW)).doubleValue(), 0.0001d);
    }

    @Test
    public void aggregateBoltStreamsAggregatesAllMetrics() {
        Map<String, Map> stats = new HashMap<>();
        stats.put("acked", twoGsidLongWindow(5L, 7L));
        stats.put("failed", twoGsidLongWindow(1L, 2L));
        stats.put("emitted", twoStreamLongWindow(10L, 20L));
        stats.put("transferred", twoStreamLongWindow(30L, 40L));
        stats.put("executed", twoGsidLongWindow(3L, 5L));
        stats.put("process-latencies", twoGsidDoubleWindow(2.0d, 6.0d));
        stats.put("execute-latencies", twoGsidDoubleWindow(4.0d, 8.0d));

        Map<String, Map> result = StatsUtil.aggregateBoltStreams(stats);

        assertEquals(12L, ((Number) result.get("acked").get(WINDOW)).longValue());
        assertEquals(8L, ((Number) result.get("executed").get(WINDOW)).longValue());
        assertEquals(52.0d / 12.0d, ((Number) result.get("process-latencies").get(WINDOW)).doubleValue(), 0.0001d);
        assertEquals(6.5d, ((Number) result.get("execute-latencies").get(WINDOW)).doubleValue(), 0.0001d);
    }

    @Test
    public void preProcessStreamSummaryFiltersSystemStreams() {
        Map<String, Map<String, Map<String, Long>>> summary = new HashMap<>();
        summary.put("emitted", systemStreamWindow(5L, 9L));
        summary.put("transferred", systemStreamWindow(6L, 10L));

        Map<String, Map<String, Map<String, Long>>> result = StatsUtil.preProcessStreamSummary(summary, false);

        assertTrue(result.get("emitted").get(WINDOW).containsKey(STREAM));
        assertFalse(result.get("emitted").get(WINDOW).containsKey("__system"));
        assertFalse(result.get("transferred").get(WINDOW).containsKey("__system"));
    }

    @Test
    public void preProcessStreamSummaryKeepsSystemStreamsWhenRequested() {
        Map<String, Map<String, Map<String, Long>>> summary = new HashMap<>();
        summary.put("emitted", systemStreamWindow(5L, 9L));
        summary.put("transferred", systemStreamWindow(6L, 10L));

        Map<String, Map<String, Map<String, Long>>> result = StatsUtil.preProcessStreamSummary(summary, true);

        assertTrue(result.get("emitted").get(WINDOW).containsKey("__system"));
        assertTrue(result.get("transferred").get(WINDOW).containsKey("__system"));
    }

    @Test
    public void mergeAggCompStatsTopoPageBoltSumsFieldsAndUsesMaximumCapacity() {
        Map<String, Object> accumulated = boltAggregateInput(2, 3L, 0.4d);
        Map<String, Object> current = boltAggregateInput(0, 5L, 0.9d);

        Map<String, Object> result = StatsUtil.mergeAggCompStatsTopoPageBolt(accumulated, current);

        assertEquals(3, result.get("num-executors"));
        assertEquals(8L, ((Number) result.get("num-tasks")).longValue());
        assertEquals(0.9d, ((Number) result.get("capacity")).doubleValue(), 0.0001d);
    }

    @Test
    public void mergeAggCompStatsTopoPageSpoutSumsFields() {
        Map<String, Object> accumulated = spoutAggregateInput(1, 2L);
        Map<String, Object> current = spoutAggregateInput(0, 5L);

        Map<String, Object> result = StatsUtil.mergeAggCompStatsTopoPageSpout(accumulated, current);

        assertEquals(2, result.get("num-executors"));
        assertEquals(7L, ((Number) result.get("num-tasks")).longValue());
        assertEquals(7L, ((Number) result.get("acked")).longValue());
    }

    @Test
    public void mergeAggCompStatsCompPageBoltCalculatesExecutorLatencies() {
        Map<String, Object> accumulated = new HashMap<>();
        accumulated.put("num-executors", 1);
        accumulated.put("executor-stats", new ArrayList<Map<String, Object>>());
        accumulated.put("sid->output-stats", new HashMap<String, Map<String, Object>>());
        accumulated.put("cid+sid->input-stats", new HashMap<List<String>, Map<String, Object>>());

        Map<String, Object> bolt = executorMetadata();
        Map<List<String>, Map<String, Object>> input = new HashMap<>();
        Map<String, Object> metrics = new HashMap<>();
        metrics.put("executed", 4L);
        metrics.put("acked", 2L);
        metrics.put("failed", 1L);
        metrics.put("executeLatencyTotal", 40.0d);
        metrics.put("processLatencyTotal", 12.0d);
        input.put(Arrays.asList("component", STREAM), metrics);
        bolt.put("cid+sid->input-stats", input);
        bolt.put("sid->output-stats", new HashMap<String, Map<String, Object>>());

        Map<String, Object> result = StatsUtil.mergeAggCompStatsCompPageBolt(accumulated, bolt);
        Map executor = (Map) ((List) result.get("executor-stats")).get(0);

        assertEquals(10.0d, ((Number) executor.get("execute-latency")).doubleValue(), 0.0001d);
        assertEquals(3.0d, ((Number) executor.get("process-latency")).doubleValue(), 0.0001d);
    }

    @Test
    public void mergeAggCompStatsCompPageSpoutCalculatesExecutorLatency() {
        Map<String, Object> accumulated = new HashMap<>();
        accumulated.put("num-executors", 1);
        accumulated.put("executor-stats", new ArrayList<Map<String, Object>>());
        accumulated.put("sid->output-stats", new HashMap<String, Map<String, Object>>());

        Map<String, Object> spout = executorMetadata();
        Map<String, Object> metrics = new HashMap<>();
        metrics.put("acked", 5L);
        metrics.put("failed", 1L);
        metrics.put("emitted", 8L);
        metrics.put("transferred", 9L);
        metrics.put("completeLatencyTotal", 25.0d);
        spout.put("sid->output-stats", singletonMap(STREAM, metrics));

        Map<String, Object> result = StatsUtil.mergeAggCompStatsCompPageSpout(accumulated, spout);
        Map executor = (Map) ((List) result.get("executor-stats")).get(0);

        assertEquals(5.0d, ((Number) executor.get("complete-latency")).doubleValue(), 0.0001d);
    }

